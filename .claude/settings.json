{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/prevent_dangerous_bash.py"
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/require_clean_commit.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/post_edit_notice.py"
          }
        ]
      }
    ]
  }
}
